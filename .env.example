# Yggaro Lite Server — example environment file.
#
# Copy to /etc/yggaro-server.env, fill in real values, and keep it root-only:
#   install -m 600 /dev/null /etc/yggaro-server.env
#
# This file is an EXAMPLE. Every value below is a placeholder, not a usable
# secret. Generate your own; never commit a filled-in copy to Git.
#
# Full reference: docs/configuration.md

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Protects the at-rest database key. Generate once, then store a copy OFF the
# server: without it, your backups are permanently unreadable.
#   head -c 32 /dev/urandom | base64 | tr -d '=+/' | head -c 32
YGGARO_DB_PASSPHRASE=replace-me

# One-time token that gates creation of the first administrator. Without it,
# a stranger who finds your instance before you finish setup can claim it.
#   head -c 18 /dev/urandom | base64 | tr -d '=+/' | head -c 16
YGGARO_BOOTSTRAP_TOKEN=replace-me

# ---------------------------------------------------------------------------
# Paths (defaults are usually fine)
# ---------------------------------------------------------------------------

# YGGARO_DATA=/var/lib/yggaro
# YGGARO_KEYS=/var/lib/yggaro-keys

# ---------------------------------------------------------------------------
# MCP — connecting your own AI client. Off unless you turn it on.
# ---------------------------------------------------------------------------

# YGGARO_MCP=1
# YGGARO_MCP_OAUTH=1

# Lets OAuth consent request the pre-approved high-impact write scope.
# Leave off unless you have a specific reason; see docs/mcp-permissions.md.
# YGGARO_MCP_OAUTH_WRITE_HIGH=1

# Narrow compatibility switch for affected MCP clients. Not a normal default.
# YGGARO_MCP_OAUTH_COMPAT=1

# ---------------------------------------------------------------------------
# Microsoft Entra SSO — optional. All three are required together.
# ---------------------------------------------------------------------------

# YGGARO_OIDC_TENANT=
# YGGARO_OIDC_CLIENT_ID=
# YGGARO_OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# SharePoint / Microsoft Graph — optional, preview. All four required together;
# setting only part of the family does not enable the integration.
# ---------------------------------------------------------------------------

# YGGARO_GRAPH_TENANT=
# YGGARO_GRAPH_CLIENT_ID=
# YGGARO_GRAPH_CLIENT_SECRET=
# YGGARO_GRAPH_SITE=
